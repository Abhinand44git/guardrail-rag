# --- Database ---
POSTGRES_USER=guardrail
POSTGRES_PASSWORD=guardrail
POSTGRES_DB=guardrail_rag
DATABASE_URL=postgresql+asyncpg://guardrail:guardrail@db:5432/guardrail_rag

# --- Static app secrets (per decision log: env vars, never in code/Git) ---
# Local dev: these live only in this .env file (git-ignored). Deployed: set the
# same variable names in Railway/Render's dashboard instead of a file. See
# README.md "Secrets, concretely" for the full decision. Generate independent
# values per environment -- don't reuse a local dev secret in production.
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Fernet key for encrypting tenants.llm_api_key_ref. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_MASTER_KEY=replace-with-generated-fernet-key

# No default generation-provider vars here on purpose -- GuardRail owns no
# generation model. Each tenant's company default is set at runtime via
# PATCH /admin/tenant-config (Admin), stored encrypted in tenants.llm_*.
# Each user's personal override is set via PATCH /user/llm-config.

# Embedding provider -- self-hosted in its OWN container (ADR-0012), NOT the HuggingFace
# Inference API and not inside the API process. Sending every ingested chunk (not just what a
# query retrieves) to a third party in plaintext was judged a larger, ungated exposure than the
# generation-model question. The `embedder` image has the model and its remote code baked in at
# build time (one-time internet access on the build machine); running containers never contact
# Hugging Face, and in docker-compose the embedder has no route to the internet at all.
#
# EMBEDDING_MODEL_NAME must match the model the embedder image was built with (compose passes
# this same variable to the build). If they differ the API refuses to store the vectors and tells
# you to rebuild: `docker compose build embedder`.
EMBEDDING_MODEL_NAME=nomic-ai/nomic-embed-text-v1.5
# Where the API finds the embedder. The default is the compose service name; you only set this
# when running the API outside compose.
EMBEDDER_URL=http://embedder:8000
# Seconds per request (each request is a batch of EMBEDDER_BATCH_SIZE chunks, about 3 s/chunk on
# a laptop CPU), and chunks per request. Keep the batch size <= 32 (the embedder's limit).
EMBEDDER_TIMEOUT_SECONDS=120
EMBEDDER_BATCH_SIZE=16
# Optional: memory cap for the embedder container (default 3g).
# EMBEDDER_MEM_LIMIT=3g

# Ingestion (Phase 4). Rejects a single upload larger than this before
# reading it into memory — synchronous ingestion has no background worker to
# hand a huge file off to (see decision log, Session 5 addendum #4).
INGEST_MAX_FILE_SIZE_MB=20

# Host port for the database container, for your own psql/GUI tools only (the api container reaches
# the database as db:5432 inside Docker and ignores this). Change it if another PostgreSQL on your
# machine already uses 5432 -- on Windows that shows up as "ports are not available ... forbidden by
# its access permissions". Always bound to localhost.
# DB_HOST_PORT=5433
